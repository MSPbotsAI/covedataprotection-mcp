# Optional overrides — covedataprotection-mcp has no required env vars.
# Authentication is per-request via three request headers (partner/username/
# password), since Cove's JSON-RPC API requires a fresh Login exchange (no
# static long-lived API key) that returns a short-lived "visa" session token
# (valid ~15 minutes). This server performs that Login exchange itself on
# every tool call rather than persisting a visa across requests, so no
# credential or session state is ever cached:
#   X-CoveDataProtection-Partner  — the "partner" field from Login
#   X-CoveDataProtection-Username — the "username" field from Login
#   X-CoveDataProtection-Password — the "password" field from Login

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# Fixed Cove Data Protection Management Service base URL — override only if
# N-able provisions a different endpoint for your organization.
# COVEDATAPROTECTION_BASE_URL=https://api.backup.management/jsonapi
